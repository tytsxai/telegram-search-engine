# Runtime environment
APP_ENV=development

# Telegram bot token
TELEGRAM_BOT_TOKEN=

# Telegram API credentials
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=session

# Meilisearch connection
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=
MEILI_INDEX=telegram_messages
MEILI_SETTINGS_PATH=configs/meilisearch.json

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# Persistent crawler state
STATE_FILE_PATH=state.json
CHANNELS_CONFIG_PATH=configs/channels.json
